{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spendwise-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "mock-aa",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "mock:aa",
        "--",
        "--webhook",
        "http://localhost:3000/api/aa/webhook"
      ],
      "port": 4100
    },
    {
      "name": "aa-proto-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../WhatsLeft-AA",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "aa-proto-mock",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../WhatsLeft-AA",
        "run",
        "mock:aa"
      ],
      "port": 4100
    },
    {
      "name": "setu-probe",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "prototypes/setu-aa/server.mjs"
      ],
      "port": 4200
    }
  ]
}
