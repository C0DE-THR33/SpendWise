// SpendWise data model.
//
// Every table below carries a comment explaining *why* it's shaped the way
// it is — see CONVENTIONS.md #6: "Every schema addition needs a reason
// written down in the schema file itself." Read this file, not just the
// commit history, to understand the model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled (transaction-mode, pgbouncer) connection — what the app uses at
  // runtime. A serverless function can't hold a direct connection open
  // without exhausting Postgres's connection limit. See CONVENTIONS.md #7.
  url       = env("DATABASE_URL")
  // Direct (session-mode) connection — what `prisma migrate` needs, since
  // migrations need prepared statements a transaction-mode pooler can't
  // sustain.
  directUrl = env("DIRECT_URL")
}

// One row per signed-in person. `id` is the Supabase auth user id (a uuid,
// stored as text) — not a separate generated key — so every other table can
// join straight to "who owns this" without an extra lookup table. The row
// itself is created in src/app/auth/callback/route.ts right after magic-link
// sign-in; lib/auth.ts's getCurrentUser() upserts it defensively as a second
// line of defense for a session that predates that path.
model User {
  id        String   @id
  email     String   @unique
  createdAt DateTime @default(now())

  linkedAccounts LinkedAccount[]
  aaConsents     AaConsent[]
  categories     Category[]
  monthlyBudgets MonthlyBudget[]
  investments    Investment[]

  @@map("users")
}

// A bank account connected through Setu's Account Aggregator sandbox. One
// user can link several accounts (savings + credit card, say); each account
// is the parent of every transaction pulled from it, which is also how a
// Transaction proves ownership indirectly (see CONVENTIONS.md #5 — the
// ownership check for a Transaction goes through `linkedAccount.userId`,
// there is no direct `Transaction.userId`).
model LinkedAccount {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fipId                 String // Setu Financial Information Provider id (the bank)
  fipName               String
  maskedAccountNumber   String
  accountType           AccountType
  consentId             String // Setu AA consent id backing this link (AaConsent.id)
  // The FIP's own handle for this linked account, echoed in every FI data
  // session payload. It is the ONLY stable key that maps a block of fetched
  // transactions back to a row here — masked account numbers are not unique
  // across FIPs and can repeat. Nullable because the synthetic CASH account
  // has no AA link behind it; that nullability is also why lookups use
  // findFirst + conditional create rather than an upsert on a compound
  // unique containing it (CONVENTIONS.md #6).
  linkRefNumber         String?
  consentStatus         ConsentStatus @default(PENDING)
  consentExpiresAt      DateTime?
  lastSyncedAt          DateTime?
  createdAt             DateTime  @default(now())

  transactions Transaction[]

  @@index([userId])
  @@index([consentId])
  @@map("linked_accounts")
}

enum AccountType {
  SAVINGS
  CURRENT
  CREDIT_CARD
  // Manually entered cash spending. A cash transaction has no bank behind
  // it, but Transaction.linkedAccountId is non-nullable on purpose:
  // `linkedAccount.userId` is the ONE path from a transaction to its owner
  // (CONVENTIONS.md #5), and every ownership guard in the app is written
  // against it. Rather than make that column nullable — which would leave
  // manual rows with no ownership path at all, and force a second, parallel
  // owner check everywhere — each user gets one synthetic CASH account that
  // manual entries hang off. The invariant survives untouched.
  CASH
}

enum ConsentStatus {
  PENDING
  ACTIVE
  PAUSED
  REVOKED
  EXPIRED
  // The synthetic CASH account above. It is not backed by an AA consent at
  // all, so none of the real statuses are true of it — marking it ACTIVE
  // would claim a consent that does not exist and make it show up as a
  // live bank link in Settings.
  NOT_APPLICABLE
}

// One row per consent request raised with Setu's AA gateway.
//
// Why this exists at all: a consent is created *before* any account is
// known — the user picks their FIPs and accounts on Setu's screens, minutes
// later, in a different browser context. Until they do, the only thing
// tying a Setu consent id to a SpendWise user is this row. Both paths back
// from Setu (the browser redirect to /connect-bank?id=..., and the
// server-to-server webhook at /api/aa/webhook) arrive carrying nothing but
// that consent id, and neither may be trusted to say who the user is — the
// webhook in particular is an unauthenticated public endpoint. Looking the
// id up here is what turns it into an ownership fact (CONVENTIONS.md #5).
//
// `dataRangeFrom`/`dataRangeTo` are stored because Setu rejects a data
// session whose range falls outside the range the consent was raised with,
// and by the time a session is created the original request object is long
// gone.
model AaConsent {
  id            String        @id // Setu's own consent id (a uuid), not a generated key
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  vua           String // the virtual user address (<mobile>@<aa handle>) the consent was raised against
  status        ConsentStatus @default(PENDING)
  dataRangeFrom DateTime
  dataRangeTo   DateTime
  expiresAt     DateTime?
  // Set once the consent's accounts have been turned into LinkedAccount
  // rows, so the finalize path is cheap to re-run (the browser hits it on
  // every return from Setu, and the webhook may beat it there).
  linkedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([userId])
  @@map("aa_consents")
}

// A single bank-statement line, pulled from Setu AA sync or webhook. Money
// is Decimal(12,2), never Float/Int — see CONVENTIONS.md #6 — and is only
// ever converted to `number` at the query-layer read boundary (toNum()).
//
// `categoryId` is nullable: a fresh transaction arrives uncategorized, and
// "uncategorized" is a real, first-class state the UI renders explicitly
// rather than a gap that makes percentages not sum to 100% (see
// CONVENTIONS.md #4). `externalId` de-dupes re-syncs of the same statement
// line from the FIP.
model Transaction {
  id              String          @id @default(cuid())
  linkedAccountId String
  linkedAccount   LinkedAccount   @relation(fields: [linkedAccountId], references: [id], onDelete: Cascade)
  externalId      String // FIP's own transaction id, for de-duping re-syncs
  amount          Decimal         @db.Decimal(12, 2)
  direction       TransactionDirection
  description     String
  merchantName    String?
  mode             String? // UPI / NEFT / IMPS / CARD / ... as reported by the FIP
  transactionDate DateTime
  categoryId      String?
  category        Category?       @relation(fields: [categoryId], references: [id])
  categorySource  CategorySource? // how it got categorized, once it is
  createdAt       DateTime        @default(now())

  @@unique([linkedAccountId, externalId])
  @@index([linkedAccountId, transactionDate])
  @@index([categoryId])
  @@map("transactions")
}

enum TransactionDirection {
  DEBIT
  CREDIT
}

enum CategorySource {
  RULE // matched a deterministic rule (merchant/keyword)
  LLM // ambiguous case, resolved by the Claude API
  MANUAL // user picked it themselves in CategorizeSheet
}

// Six known icons, matching the hand-drawn stroke-SVG set the icon-tile
// component (components/transactions/CategoryTile.tsx) actually ships.
// `icon` is stored as plain text below because Postgres can't enforce a
// closed set on a text column — the runtime narrowing happens at the query
// boundary via asCategoryIcon() (CONVENTIONS.md #4), not here.
//
// `userId` is nullable: null means a shipped default category (seeded by
// prisma/seed.ts, safe to run anywhere), non-null means a user's own custom
// category. Because a nullable column in a compound @@unique can't reliably
// back an upsert (Postgres treats every NULL as distinct — see
// CONVENTIONS.md #6), the seed script uses findFirst + conditional create
// instead of `upsert` here.
model Category {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  icon      String // one of CATEGORY_ICONS in lib/categories.ts
  color     String // CSS custom-property name, e.g. "cat-food"
  createdAt DateTime @default(now())

  transactions   Transaction[]
  categoryBudgets CategoryBudget[]

  @@unique([userId, name])
  @@map("categories")
}

// A user's total budget for one calendar month. Split from CategoryBudget
// into its own table — rather than one table with a nullable categoryId —
// specifically so neither table ever needs a nullable column inside a
// unique constraint (CONVENTIONS.md #6).
model MonthlyBudget {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year        Int
  month       Int // 1-12
  totalAmount Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  categoryBudgets CategoryBudget[]

  @@unique([userId, year, month])
  @@map("monthly_budgets")
}

// One category's slice of a MonthlyBudget. See MonthlyBudget above for why
// this is a separate table rather than a nullable FK on it.
model CategoryBudget {
  id              String        @id @default(cuid())
  monthlyBudgetId String
  monthlyBudget   MonthlyBudget @relation(fields: [monthlyBudgetId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  amount          Decimal       @db.Decimal(12, 2)

  @@unique([monthlyBudgetId, categoryId])
  @@map("category_budgets")
}

// A holding the user has told us about by hand. There's no live brokerage
// integration in v1 — the Investments page is a manually-maintained ledger,
// not a synced one — so this stays deliberately simple.
model Investment {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  type         InvestmentType
  investedAmount Decimal      @db.Decimal(12, 2)
  currentValue Decimal        @db.Decimal(12, 2)
  updatedAt    DateTime       @updatedAt
  createdAt    DateTime       @default(now())

  @@index([userId])
  @@map("investments")
}

enum InvestmentType {
  MUTUAL_FUND
  STOCK
  FIXED_DEPOSIT
  GOLD
  OTHER
}
